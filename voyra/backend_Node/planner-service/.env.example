# ---------------------------------------------------------------------------
# Planner Service (4004) - primer podesavanja
#
# Kopiraj u `.env` istog foldera:   cp .env.example .env
#
# Vrednosti ispod RADE bez ijednog spoljnog kljuca (demo rezim). Menjaj ih
# samo ako menjas portove, bazu ili ukljucujes prave API-je.
#
# JWT_SECRET i INTERNAL_API_KEY moraju biti ISTI u svih devet servisa.
# Vrednosti ispod su razvojni placeholderi, NE tajne - pre izlaganja
# aplikacije van ove masine zameni ih slucajnim niskama.
# ---------------------------------------------------------------------------

# --- Port (servis je bez baze) --------------------------------------------
PLANNER_SERVICE_PORT=4004

# Samo INTERNAL_API_KEY - ovaj servis ne prima korisnicke tokene.
INTERNAL_API_KEY=razvojni_internal_key_promeni_pre_produkcije

# --- Adrese servisa -------------------------------------------------------
INTEGRATION_SERVICE_URL=http://localhost:4003
INTEGRATION_TIMEOUT_MS=10000
# Odatle se citaju kategorije interesovanja (kes 60 s, pa ugradjena tabela).
TRIP_SERVICE_URL=http://localhost:4002
SERVICE_TIMEOUT_MS=5000

# --- OpenAPI dokumentacija -------------------------------------------------
# /docs i /docs/openapi.json. `false` gasi dokumentaciju (za produkciju).
DOCS_ENABLED=true
