# ---------------------------------------------------------------------------
# Notification Service (4007) - primer podesavanja
#
# Kopiraj u `.env` istog foldera:   cp .env.example .env
#
# Vrednosti ispod RADE bez ijednog spoljnog kljuca (demo rezim). Menjaj ih
# samo ako menjas portove, bazu ili ukljucujes prave API-je.
#
# JWT_SECRET i INTERNAL_API_KEY moraju biti ISTI u svih devet servisa.
# Vrednosti ispod su razvojni placeholderi, NE tajne - pre izlaganja
# aplikacije van ove masine zameni ih slucajnim niskama.
# ---------------------------------------------------------------------------

# --- Port i baza ----------------------------------------------------------
NOTIFICATION_SERVICE_PORT=4007
MONGODB_URI=mongodb://localhost:27017/notifications_db
# Isto sto i MONGODB_URI; citaju ga starije skripte.
NOTIFICATION_DB_URL=mongodb://localhost:27017/notifications_db

# --- Zajednicke tajne (moraju biti iste u svim servisima) -------------------
JWT_SECRET=razvojni_jwt_secret_promeni_pre_produkcije
INTERNAL_API_KEY=razvojni_internal_key_promeni_pre_produkcije

# --- Adrese servisa -------------------------------------------------------
NOTIFICATION_SERVICE_URL=http://localhost:4007
USER_SERVICE_URL=http://localhost:4001
NOTIFICATION_TIMEOUT_MS=5000
EXTERNAL_API_TIMEOUT_MS=10000

# --- E-posta --------------------------------------------------------------
EMAIL_FROM=noreply@voyra.rs
# Prazno = e-poruke se ispisuju u konzolu (simulacija). Sva tri polja
# (HOST, USER, PASS) moraju biti popunjena da bi se poruke zaista slale.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMS (opciono) --------------------------------------------------------
# Prazno = SMS se ispisuje u konzolu.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Red za slanje --------------------------------------------------------
QUEUE_INTERVAL_MS=5000
MAX_RETRIES=3
RETRY_BACKOFF_MS=300000

# --- TTL (dani) -----------------------------------------------------------
TTL_SENT_DAYS=7
TTL_FAILED_DAYS=30
TTL_LOGS_DAYS=90

# --- OpenAPI dokumentacija -------------------------------------------------
# /docs i /docs/openapi.json. `false` gasi dokumentaciju (za produkciju).
DOCS_ENABLED=true
