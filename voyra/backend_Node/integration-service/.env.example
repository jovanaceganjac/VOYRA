# ---------------------------------------------------------------------------
# Integration Service (4003) - primer podesavanja
#
# Kopiraj u `.env` istog foldera:   cp .env.example .env
#
# Vrednosti ispod RADE bez ijednog spoljnog kljuca (demo rezim). Menjaj ih
# samo ako menjas portove, bazu ili ukljucujes prave API-je.
#
# JWT_SECRET i INTERNAL_API_KEY moraju biti ISTI u svih devet servisa.
# Vrednosti ispod su razvojni placeholderi, NE tajne - pre izlaganja
# aplikacije van ove masine zameni ih slucajnim niskama.
# ---------------------------------------------------------------------------

# --- Port i baza ----------------------------------------------------------
INTEGRATION_SERVICE_PORT=4003
MONGODB_URI=mongodb://localhost:27017/integration_db
# Baza koju koristi `npm run proba:adapteri`.
MONGODB_TEST_URI=mongodb://localhost:27017/integration_test_db

# Samo INTERNAL_API_KEY - ovaj servis ne prima korisnicke tokene.
INTERNAL_API_KEY=razvojni_internal_key_promeni_pre_produkcije

# --- Demo podaci ----------------------------------------------------------
# Odakle se citaju demo letovi, smestaj i atrakcije kada nema kljuceva.
MOCK_DATA_PATH=../../mock_data
# Koliko vazi demo ponuda leta.
MOCK_OFFER_TTL_MINUTES=20
EXTERNAL_API_TIMEOUT_MS=10000

# --- Kes (sekunde) --------------------------------------------------------
CACHE_TTL_FLIGHTS=900
CACHE_TTL_ACCOMMODATIONS=1800
CACHE_TTL_ATTRACTIONS=604800
CACHE_TTL_RATES=86400
CACHE_TTL_GEOCODE=2592000
CACHE_TTL_ATTRACTION_DETAILS=2592000
# Ponuda leta iz kesa se odbacuje ako istice za manje od ovoliko sekundi.
OFFER_MIN_VALID_SECONDS=120

# ===========================================================================
# SPOLJNI API-ji
#
# SVI su opcioni. Bez ijednog kljuca servis radi na demo podacima i polje
# `source` u odgovoru kaze `mock`. Kljucevi se upisuju SAMO ovde - nijedan
# drugi servis i nijedan deo frontenda ih ne vidi.
# ===========================================================================

# --- Letovi: Duffel (duffel.com, Test mode) -------------------------------
# Test token pocinje sa `duffel_test_`.
DUFFEL_API_KEY=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_MAX_OFFERS=5

# --- Smestaj: LiteAPI (liteapi.travel) ------------------------------------
# Sandbox kljuc pocinje sa `sand_`.
LITEAPI_API_KEY=
LITEAPI_API_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_CANDIDATES=25
LITEAPI_MAX_RESULTS=5
LITEAPI_GUEST_NATIONALITY=RS

# --- Atrakcije, prvi izbor: Geoapify Places -------------------------------
# https://apidocs.geoapify.com/docs/places/ - kljuc je 32 heksadecimalna
# znaka. 1 kredit na 20 mesta, 3000 kredita dnevno na besplatnom planu.
GEOAPIFY_API_KEY=
GEOAPIFY_API_BASE_URL=https://api.geoapify.com/v2
GEOAPIFY_RADIUS_M=15000
GEOAPIFY_RADIUS_WIDE_M=25000
GEOAPIFY_LIMIT_MIN=120
GEOAPIFY_LIMIT_MAX=120
GEOAPIFY_LIMIT_PER_TARGET=8
GEOAPIFY_DAILY_CREDITS=3000
# Jezik naziva; `en` daje medjunarodni naziv umesto lokalnog pisma.
GEOAPIFY_LANG=en

# --- Atrakcije, rezerva: OpenTripMap --------------------------------------
# Koristi se samo ako Geoapify kljuc nije upisan.
OPENTRIPMAP_API_KEY=
OPENTRIPMAP_API_BASE_URL=https://api.opentripmap.com/0.1/en
OPENTRIPMAP_RADIUS_M=15000
OPENTRIPMAP_RADIUS_WIDE_M=25000
OPENTRIPMAP_LIMIT_MIN=60
OPENTRIPMAP_LIMIT_MAX=200
OPENTRIPMAP_LIMIT_PER_TARGET=3

# --- Bez kljuca: kursna lista, geokodiranje, slike ------------------------
FRANKFURTER_API_BASE_URL=https://api.frankfurter.dev
NOMINATIM_API_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim i Wikipedia traze prepoznatljiv User-Agent.
NOMINATIM_USER_AGENT=Voyra/1.0 (diplomski rad, ETF Beograd)
WIKIPEDIA_API_BASE_URL=https://{jezik}.wikipedia.org/api/rest_v1
WIKIPEDIA_USER_AGENT=Voyra/1.0 (diplomski rad, ETF Beograd)

# --- OpenAPI dokumentacija -------------------------------------------------
# /docs i /docs/openapi.json. `false` gasi dokumentaciju (za produkciju).
DOCS_ENABLED=true
