# ---------------------------------------------------------------------------
# Booking Service (4006) - primer podesavanja
#
# Kopiraj u `.env` istog foldera:   cp .env.example .env
#
# Vrednosti ispod RADE bez ijednog spoljnog kljuca (demo rezim). Menjaj ih
# samo ako menjas portove, bazu ili ukljucujes prave API-je.
#
# JWT_SECRET i INTERNAL_API_KEY moraju biti ISTI u svih devet servisa.
# Vrednosti ispod su razvojni placeholderi, NE tajne - pre izlaganja
# aplikacije van ove masine zameni ih slucajnim niskama.
# ---------------------------------------------------------------------------

# --- Port i baza ----------------------------------------------------------
BOOKING_SERVICE_PORT=4006
MONGODB_URI=mongodb://localhost:27017/booking_db
# Isto sto i MONGODB_URI; citaju ga skripte ovog servisa.
MONGODB_URL=mongodb://localhost:27017/booking_db

# Baze drugih servisa koje skripta proba:rezervacija cita.
MONGODB_USERS_DB=mongodb://localhost:27017/users_db
MONGODB_TRIPS_DB=mongodb://localhost:27017/trips_db

# --- Zajednicke tajne (moraju biti iste u svim servisima) -------------------
JWT_SECRET=razvojni_jwt_secret_promeni_pre_produkcije
INTERNAL_API_KEY=razvojni_internal_key_promeni_pre_produkcije

# --- Adrese servisa -------------------------------------------------------
BOOKING_SERVICE_URL=http://localhost:4006
TRIP_SERVICE_URL=http://localhost:4002
# Sve prema Duffel-u ide kroz Integration Service - ovde nema kljuceva.
INTEGRATION_SERVICE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4007
EXTERNAL_API_TIMEOUT_MS=20000
NOTIFICATION_TIMEOUT_MS=5000

# --- Rezervacija ----------------------------------------------------------
# Koliko vazi nacrt rezervacije pre nego sto ga TTL indeks obrise.
DRAFT_TTL_MINUTES=30
# Folder za PDF potvrde, relativno na koren servisa.
CONFIRMATION_DIR=./confirmations
# `false` salje pravu e-postu; sve ostalo znaci ispis u konzolu.
EMAIL_SIMULATION_MODE=true

# --- OpenAPI dokumentacija -------------------------------------------------
# /docs i /docs/openapi.json. `false` gasi dokumentaciju (za produkciju).
DOCS_ENABLED=true
