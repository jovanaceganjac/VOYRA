# ---------------------------------------------------------------------------
# Trip Service (4002) - primer podesavanja
#
# Kopiraj u `.env` istog foldera:   cp .env.example .env
#
# Vrednosti ispod RADE bez ijednog spoljnog kljuca (demo rezim). Menjaj ih
# samo ako menjas portove, bazu ili ukljucujes prave API-je.
#
# JWT_SECRET i INTERNAL_API_KEY moraju biti ISTI u svih devet servisa.
# Vrednosti ispod su razvojni placeholderi, NE tajne - pre izlaganja
# aplikacije van ove masine zameni ih slucajnim niskama.
# ---------------------------------------------------------------------------

# --- Port i baza ----------------------------------------------------------
TRIP_SERVICE_PORT=4002
MONGODB_URI=mongodb://localhost:27017/trips_db
# Isto sto i MONGODB_URI; citaju ga skripte za uvoz i seed.
MONGODB_URL=mongodb://localhost:27017/trips_db

# --- Zajednicke tajne (moraju biti iste u svim servisima) -------------------
JWT_SECRET=razvojni_jwt_secret_promeni_pre_produkcije
INTERNAL_API_KEY=razvojni_internal_key_promeni_pre_produkcije

# --- Adrese servisa -------------------------------------------------------
GATEWAY_URL=http://localhost:4000
PLANNER_SERVICE_URL=http://localhost:4004
BOOKING_SERVICE_URL=http://localhost:4006
PLANNER_TIMEOUT_MS=30000
EXTERNAL_API_TIMEOUT_MS=15000

# --- Statistika i pozadinski posao ----------------------------------------
# Koliko dana se pamti zapis pretrage (osnova za popularne destinacije).
SEARCH_STATS_TTL_DAYS=90
# Koliko cesto se putovanja sa proslim datumom prebacuju u ZAVRSENO.
COMPLETED_JOB_INTERVAL_MS=3600000

# --- OpenAPI dokumentacija -------------------------------------------------
# /docs i /docs/openapi.json. `false` gasi dokumentaciju (za produkciju).
DOCS_ENABLED=true
