{
  "name": "voyra-e2e",
  "version": "1.0.0",
  "description": "Selenium end-to-end testovi za Voyra",
  "private": true,
  "scripts": {
    "test": "mocha --config .mocharc.json",
    "test:vidljivo": "mocha --config .mocharc.json -- --vidljivo",
